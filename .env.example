# Copy to .env and fill in real values.
# Local VPS defaults: Manager + DBs all on 127.0.0.1 — set ISSUED_HOST to the host your apps dial.

# === Admin — always ===
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me-now
APP_ENCRYPTION_KEY=
# Generate with: openssl rand -base64 32 (or hex: openssl rand -hex 32)
# When blank, per-DB passwords stored plaintext (dev only).

# === MongoDB ===
MONGO_ENABLED=false
MONGODB_ISSUED_HOST=
MONGODB_ROOT_PASSWORD=change-me-now

# === PostgreSQL ===
POSTGRES_ENABLED=false
POSTGRES_ISSUED_HOST=          # DNS only, no :port (e.g. pg.example.com)
POSTGRES_ISSUED_PORT=5432      # public direct A -> 127.0.0.1:9813 (migrations/admin, non-standard prod e.g. 27431)
PGBOUNCER_ISSUED_PORT=6432     # public pooled B -> 127.0.0.1:6432 (app/workers, non-standard prod e.g. 27432)
POSTGRES_ROOT_PASSWORD=change-me-now
PGBOUNCER_ADMIN_PASSWORD=change-me-now
PGBOUNCER_STATS_PASSWORD=change-me-now

# === MySQL ===
MYSQL_ENABLED=false
MYSQL_ISSUED_HOST=
MYSQL_ROOT_PASSWORD=change-me-now

# === Network / HTTPS (advanced) ===
# SERVER_ADDRESS=127.0.0.1
# RATE_LIMIT_TRUST_XFF=false
# Behind reverse proxy / Cloudflare Tunnel: SERVER_ADDRESS=127.0.0.1, RATE_LIMIT_TRUST_XFF=true

# === Overrides — local 127.0.0.1 is default, uncomment only for remote/tuning ===
# Manager -> DB root links (same host via Docker — only change for Atlas/RDS):
# OVERRIDE_MONGODB_URI=mongodb+srv://<clusterAdmin>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# OVERRIDE_POSTGRES_URI=jdbc:postgresql://pg.example.com:5432/postgres?sslmode=require
# OVERRIDE_MYSQL_URI=jdbc:mysql://mysql.example.com:3306/mysql?sslMode=REQUIRED&allowPublicKeyRetrieval=true&serverTimezone=UTC
# _TLS is boolean (Mongo/MySQL), _SSLMODE is enum (Postgres only) — intentional split, not inconsistency:
# OVERRIDE_MONGODB_TLS=false
# OVERRIDE_POSTGRES_SSLMODE=require
# OVERRIDE_MYSQL_TLS=false
# PgBouncer tuning (managed like pgvector — only override to tune):
# OVERRIDE_PGBOUNCER_PORT=6432
# OVERRIDE_PGBOUNCER_POOL_MODE=transaction
# OVERRIDE_PGBOUNCER_MAX_CLIENT_CONN=1000
# OVERRIDE_PGBOUNCER_DEFAULT_POOL_SIZE=25

# Local ports: App 9811, Mongo 127.0.0.1:9812, Postgres 127.0.0.1:9813, mongo-express 127.0.0.1:9814, Adminer 127.0.0.1:9815, MySQL 127.0.0.1:9816, phpMyAdmin 127.0.0.1:9817, PgBouncer 127.0.0.1:6432.
