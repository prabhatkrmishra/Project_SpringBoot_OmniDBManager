# Copy to .env and fill in real values.
# Key generation using 'openssl rand -hex 32'

# App admin login (used to sign in to the web UI)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me-now

# Local MongoDB root credentials
MONGODB_ROOT_USERNAME=root
MONGODB_ROOT_PASSWORD=change-me-now

# mongo-express web UI basic auth
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=change-me-now

# MongoDB Atlas connection string (used with profile "atlas"):
# Leave MONGODB_URI unset: application.yml falls back to the local Docker Compose
# NOTE: an empty MONGODB_URI= (instead of commented out) breaks that fallback, so
# only set it to a real value here, or keep this line commented.
# e.g. mongodb+srv://<clusterAdmin>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_URI=

# Network binding. Default 127.0.0.1 (loopback only): reach the app through a
# reverse proxy / tunnel. Set to 0.0.0.0 to expose it directly.
# SERVER_ADDRESS=127.0.0.1

# Login rate limiter: honor X-Forwarded-For (real client IPs) only when the app
# sits behind a trusted proxy/tunnel. Keep false when reachable directly.
# RATE_LIMIT_TRUST_XFF=false

# Public MongoDB host used in the connection strings shown in the UI.
# Set when Mongo is reachable via a domain name (e.g. behind a reverse proxy /
# tunnel that forwards to the local Mongo port); leave unset to derive from
# MONGODB_URI / the local fallback. Add ":port" only if clients must reach a
# non-default port through the domain (drivers default to 27017).
# MONGODB_PUBLIC_HOST=public.domain.name.com

# Local ports (Docker Compose): MongoDB 9812, mongo-express 127.0.0.1:9814, Postgres 9813, Adminer 127.0.0.1:9815.

# Local Postgres root credentials
POSTGRES_ROOT_USER=root
POSTGRES_ROOT_PASSWORD=change-me-now

# Postgres connection (used when POSTGRES_ENABLED=true)
# POSTGRES_URI=jdbc:postgresql://127.0.0.1:9813/postgres?sslmode=disable

# Public Postgres host used in the connection strings shown in the UI
# POSTGRES_PUBLIC_HOST=postgres.example.com
# POSTGRES_PUBLIC_TLS=false
# POSTGRES_PUBLIC_SSLMODE=require
# For verify-full with CA (enterprise TLS):
# POSTGRES_PUBLIC_SSLMODE=verify-full
# POSTGRES_URI=jdbc:postgresql://127.0.0.1:9813/postgres?sslmode=verify-full&sslrootcert=./certs/ca.crt
# Mount certs in compose.yaml (see postgres service comments) and set pg_hba.conf hostssl.

# Adminer (Postgres explorer) base URL
# ADMINER_BASE_URL=http://127.0.0.1:9815

# Encryption at rest for stored per-database passwords (AES-256-GCM).
# Generate with: openssl rand -base64 32  (or hex: openssl rand -hex 32)
# When blank, passwords are stored plaintext (dev only).
# APP_ENCRYPTION_KEY=base64-32-bytes-here
