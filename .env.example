# Copy to .env and fill in real values.
# Key generation using 'openssl rand -hex 32'

# === App admin login (used to sign in to the web UI) ===
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me-now

# === Network / HTTPS ===
# Condition A: Local dev (no TLS) — keep defaults (loopback only)
# SERVER_ADDRESS=127.0.0.1
# RATE_LIMIT_TRUST_XFF=false
# Condition B: Behind reverse proxy / Cloudflare Tunnel terminating TLS (recommended for https://)
#   App stays 127.0.0.1, proxy forwards to 127.0.0.1:9811 and sets X-Forwarded-Proto/For.
#   application.yml already has forward-headers-strategy: framework.
#   Nginx example: listen 443 ssl; proxy_pass http://127.0.0.1:9811; proxy_set_header X-Forwarded-Proto $scheme;
# SERVER_ADDRESS=127.0.0.1
# RATE_LIMIT_TRUST_XFF=true
# Condition C: Expose directly without proxy (not recommended for public)
# SERVER_ADDRESS=0.0.0.0
# RATE_LIMIT_TRUST_XFF=false
# No server.ssl.* needed — TLS is at the proxy. If you embed certs instead, set server.ssl.* in application.yml.

# === MongoDB engine ===
# Condition: Local Docker Compose (default) — uncomment to enable DB provisioning
# MONGO_ENABLED=true
MONGODB_ROOT_USERNAME=root
MONGODB_ROOT_PASSWORD=change-me-now
# Condition: Atlas / remote Mongo — set full URI (leave commented for local fallback)
# NOTE: `MONGODB_URI=` (empty) is normalized to absent so fallback works; but keep commented unless remote.
# e.g. mongodb+srv://<clusterAdmin>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_URI=

# mongo-express web UI basic auth (loopback 9814, proxied via app /mongo-express)
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=change-me-now

# Condition: Clients dial Mongo via public domain (proxy/tunnel) — issued strings use this host
#   a) Plain (no DB TLS): leave MONGODB_PUBLIC_TLS=false, strings = mongodb://user:pass@host/db?authSource=db
#   b) TLS via proxy/mongod TLS: set MONGODB_PUBLIC_HOST + MONGODB_PUBLIC_TLS=true → adds &tls=true
#      For mongod native TLS or Nginx stream `listen 27017 ssl; proxy_pass 127.0.0.1:9812;`
# MONGODB_PUBLIC_HOST=mongo.example.com   # add :port only if non-27017 via domain
# MONGODB_PUBLIC_TLS=false

# Local ports: MongoDB 9812, mongo-express 127.0.0.1:9814, Postgres 9813, Adminer 127.0.0.1:9815, MySQL 9816, phpMyAdmin 127.0.0.1:9817.

# === PostgreSQL engine ===
POSTGRES_ROOT_USER=root
POSTGRES_ROOT_PASSWORD=change-me-now
# POSTGRES_ENABLED=true
# Condition: Local (default) — app connects via postgresDataSource to 127.0.0.1:9813
# POSTGRES_URI=jdbc:postgresql://127.0.0.1:9813/postgres?sslmode=disable
# Condition: Remote / TLS
#   a) No verify (TLS without CA): POSTGRES_PUBLIC_SSLMODE=require
#   b) Verify-full with CA: mount certs in compose.postgres.yaml (postgres service comments: server.crt/key/ca.crt + command ssl=on + pg_hba hostssl) and:
# POSTGRES_PUBLIC_HOST=pg.example.com
# POSTGRES_PUBLIC_TLS=false
# POSTGRES_PUBLIC_SSLMODE=require
# For verify-full:
# POSTGRES_PUBLIC_SSLMODE=verify-full
# POSTGRES_URI=jdbc:postgresql://127.0.0.1:9813/postgres?sslmode=verify-full&sslrootcert=./certs/ca.crt

# Adminer (Postgres explorer) base URL
# ADMINER_BASE_URL=http://127.0.0.1:9815

# === MySQL engine ===
# Local root password (superuser always `root` — do not set MYSQL_ROOT_USER)
MYSQL_ROOT_PASSWORD=change-me-now
# MYSQL_ENABLED=true
# POSTGRES_ENABLED=true  # keep here for grouping: enable per engine
# Condition: Local (default)
# MYSQL_URI=jdbc:mysql://127.0.0.1:9816/mysql?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# Condition: TLS
#   a) No verify: MYSQL_PUBLIC_SSLMODE=REQUIRED
#   b) Verify identity with CA: MYSQL_PUBLIC_SSLMODE=VERIFY_IDENTITY + URI with truststore
# MYSQL_PUBLIC_HOST=mysql.example.com
# MYSQL_PUBLIC_TLS=false
# MYSQL_PUBLIC_SSLMODE=REQUIRED
# For VERIFY_IDENTITY:
# MYSQL_PUBLIC_SSLMODE=VERIFY_IDENTITY
# MYSQL_URI=jdbc:mysql://127.0.0.1:9816/mysql?sslMode=VERIFY_IDENTITY&trustCertificateKeyStoreUrl=file:./certs/ca.crt

# phpMyAdmin (MySQL explorer) base URL
# PHPMYADMIN_BASE_URL=http://127.0.0.1:9817

# === Encryption at rest for stored per-database passwords (AES-256-GCM) ===
# Generate with: openssl rand -base64 32  (or hex: openssl rand -hex 32)
# When blank, passwords are stored plaintext (dev only).
# APP_ENCRYPTION_KEY=base64-32-bytes-here
