# Generated by PostgresPgbouncerService on provision/reset/delete.
# Wildcard entry ensures any new Postgres DB provisioned via OmniDB is pooled after RELOAD.
[databases]
* = host=postgres port=5432 auth_user=postgres
# Per-DB entries appended dynamically, e.g.:
# myapp = host=postgres port=5432 dbname=myapp

[pgbouncer]
listen_port = 6432
listen_addr = 127.0.0.1
auth_type = scram-sha-256
auth_file = /etc/pgbouncer/userlist.txt
auth_user = postgres
pool_mode = transaction
max_client_conn = 1000
default_pool_size = 25
reserve_pool_size = 5
reserve_pool_timeout = 3
max_db_connections = 50
server_reset_query = DISCARD ALL
ignore_startup_parameters = extra_float_digits
admin_users = pgbouncer_admin
stats_users = pgbouncer_stats
