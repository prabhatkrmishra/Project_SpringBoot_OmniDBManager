# Nginx reverse-proxy template for OmniDB Manager.
#
# Setup on the VPS:
#   sudo apt install nginx certbot python3-certbot-nginx
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/omnidb
#   sudo nano /etc/nginx/sites-available/omnidb   # set your domain
#   sudo ln -s /etc/nginx/sites-available/omnidb /etc/nginx/sites-enabled/
#   sudo rm -f /etc/nginx/sites-enabled/default
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d your.domain.com              # adds TLS + redirects
#
# Then in ~/omnidb/.env set:
#   RATE_LIMIT_TRUST_XFF=true        # rate limiter keys on the real client IP
# and restart the jar. Keep SERVER_ADDRESS unset (loopback) - nginx is the
# only public entry point.

# ── HTTP: certbot manages the TLS redirect after first run ──────────────────
server {
    listen 80;
    server_name your.domain.com;

    # Restore/import uploads are up to 256MB - nginx's 1MB default rejects them.
    client_max_body_size 256m;

    # Actuator is manager-only: never serve it on a public name. On the
    # box itself it still needs the manager login (form login, ADMIN role) —
    # open it in a logged-in browser or curl with a session cookie, not
    # anonymous curl.
    location ^~ /actuator/ {
        return 404;
    }
    location = /actuator {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:9811;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

