# ── MongoDB over TLS (optional) ─────────────────────────────────────────────
# Mongo speaks raw TCP, not HTTP - this needs nginx's STREAM module, which is
# a top-level `stream {}` block in /etc/nginx/nginx.conf (NOT inside http{}).
#
# One-time setup:
#   sudo apt install libnginx-mod-stream
#   sudo mkdir -p /etc/nginx/streams-enabled
#   # add to the TOP LEVEL of /etc/nginx/nginx.conf (after the http {} block):
#   #   stream {
#   #       include /etc/nginx/streams-enabled/*.conf;
#   #   }
#
# Then save this as /etc/nginx/streams-enabled/omnidb.conf:
#
# limit_conn_zone $binary_remote_addr zone=mongo_conn_per_ip:10m;
#
# server {
#     # Standard driver port: tenant URIs need no explicit :port.
#     listen 27017 ssl;
#     proxy_pass 127.0.0.1:9812;
#
#     # nginx terminates TLS; mongod keeps speaking plaintext on loopback.
#     ssl_certificate     /etc/letsencrypt/live/your.domain.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/your.domain.com/privkey.pem;
#
#     # Guardrail: each client connection costs mongod ~0.5-1MB of RAM.
#     limit_conn mongo_conn_per_ip 20;
# }
#
# Validate and apply:
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo ufw allow 27017/tcp
#
# Finally set in ~/omnidb/.env so ISSUED connection strings are correct:
#   MONGODB_ISSUED_HOST=your.domain.com
#   OVERRIDE_MONGODB_TLS=true
# and restart the jar. New strings then read:
#   mongodb://user:pass@your.domain.com/db?authSource=db&tls=true
#
# Notes:
# - SCRAM auth still protects every database; TLS here only encrypts transport.
# - Connections already issued WITHOUT &tls=true keep working unencrypted until
#   rotated - reset passwords to reissue TLS strings.
# - mongod's own --maxConns guardrail still applies behind nginx.
#
# ── Custom public port (optional) ────────────────────────────────────────────
# A non-standard public port quiets internet-wide scanners but is camouflage,
# not a lock - anyone who finds it faces the same login. The real locks stay:
# firewall allowlist (this port open ONLY to your app servers), TLS below, and
# per-database credentials. Same shape works for Postgres/MySQL: point the
# stream at 127.0.0.1:9813 (direct), 127.0.0.1:6432 (pooled) or 127.0.0.1:9816
# and set the matching *_ISSUED_HOST to host:<custom-port> so issued strings
# carry it (no new env var needed - any host:port is accepted as-is).
#
# server {
#     listen <custom-port> ssl;
#     proxy_pass 127.0.0.1:9813;
#
#     ssl_certificate     /etc/letsencrypt/live/pg.example.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/pg.example.com/privkey.pem;
#
#     # Per-IP guardrail, same idea as the Mongo example above.
#     # limit_conn db_conn_per_ip 20;
# }
#
# Validate and apply:
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo ufw allow from <app-server-ip> to any port <custom-port> proto tcp
# Cloud firewall (NSG / security group): same rule there — this port open ONLY
# to your app servers, never 0.0.0.0/0. See DEPLOY.md "Custom Public DB Ports".
#
# Caveats:
# - Some office networks block outbound ports except 80/443 - apps behind
#   those cannot reach a custom port (that's the one case for SNI-routed 443).
# - Cloudflare's orange cloud proxies HTTP only: keep DB hostnames on grey-cloud
#   DNS (or Spectrum) or the TCP never arrives.
