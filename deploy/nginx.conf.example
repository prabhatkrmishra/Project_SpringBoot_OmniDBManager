# ── MongoDB over TLS (optional) ─────────────────────────────────────────────
# Mongo speaks raw TCP, not HTTP - this needs nginx's STREAM module, which is
# a top-level `stream {}` block in /etc/nginx/nginx.conf (NOT inside http{}).
#
# One-time setup:
#   sudo apt install libnginx-mod-stream
#   sudo mkdir -p /etc/nginx/streams-enabled
#   # add to the TOP LEVEL of /etc/nginx/nginx.conf (after the http {} block):
#   #   stream {
#   #       include /etc/nginx/streams-enabled/*.conf;
#   #   }
#
# Then save this as /etc/nginx/streams-enabled/omnidb.conf:
#
# limit_conn_zone $binary_remote_addr zone=mongo_conn_per_ip:10m;
#
# server {
#     # Standard driver port: tenant URIs need no explicit :port.
#     listen 27017 ssl;
#     proxy_pass 127.0.0.1:9812;
#
#     # nginx terminates TLS; mongod keeps speaking plaintext on loopback.
#     ssl_certificate     /etc/letsencrypt/live/your.domain.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/your.domain.com/privkey.pem;
#
#     # Guardrail: each client connection costs mongod ~0.5-1MB of RAM.
#     limit_conn mongo_conn_per_ip 20;
# }
#
# Validate and apply:
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo ufw allow 27017/tcp
#
# Finally set in ~/omnidb/.env so ISSUED connection strings are correct:
#   MONGODB_ISSUED_HOST=your.domain.com
#   OVERRIDE_MONGODB_TLS=true
# and restart the jar. New strings then read:
#   mongodb://user:pass@your.domain.com/db?authSource=db&tls=true
#
# Notes:
# - SCRAM auth still protects every database; TLS here only encrypts transport.
# - Connections already issued WITHOUT &tls=true keep working unencrypted until
#   rotated - reset passwords to reissue TLS strings.
# - mongod's own --maxConns guardrail still applies behind nginx.
#
# ── Postgres — two non-standard public TCP ports (direct A + pooled B) ───────
# Postgres is exposed on TWO separate public ports, each TLS + IP allowlist.
# DNS must be grey-cloud (DNS only) so raw TCP reaches your VPS, not Cloudflare HTTP proxy.
#   A direct (migrations/admin, tighter allowlist) → 127.0.0.1:9813
#   B pooled (app/workers) → 127.0.0.1:6432 → 127.0.0.1:9813 via PgBouncer
# Non-standard port is camouflage only — the allowlist + TLS + per-DB SCRAM are the real locks.
# Never log the real custom port — use <CUSTOM_PORT> placeholder in logs/docs.
# Env: POSTGRES_ISSUED_HOST=pg.example.com (DNS only, no :port)
#      POSTGRES_ISSUED_PORT=<NON_STD_1> e.g. 27431 (direct A)
#      PGBOUNCER_ISSUED_PORT=<NON_STD_2> e.g. 27432 (pooled B)
# pgvector stays inside the same Postgres — no extra port.
#
# Save as /etc/nginx/streams-enabled/postgres.conf (see DEPLOY.md §6):
#
# limit_conn_zone $binary_remote_addr zone=pg_direct_per_ip:10m;
# limit_conn_zone $binary_remote_addr zone=pg_pooled_per_ip:10m;
#
# server {
#     # Direct A — DDL/migrations/break-glass (tighter allowlist)
#     listen 27431 ssl;
#     ssl_certificate     /etc/letsencrypt/live/pg.example.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/pg.example.com/privkey.pem;
#     ssl_protocols TLSv1.2 TLSv1.3;
#     ssl_prefer_server_ciphers on;
#     proxy_pass 127.0.0.1:9813;
#     proxy_timeout 1h;
#     proxy_connect_timeout 10s;
#     limit_conn pg_direct_per_ip 20;
# }
# server {
#     # Pooled B — app/workers (only for DBs provisioned with Route via PgBouncer)
#     listen 27432 ssl;
#     ssl_certificate     /etc/letsencrypt/live/pg.example.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/pg.example.com/privkey.pem;
#     ssl_protocols TLSv1.2 TLSv1.3;
#     ssl_prefer_server_ciphers on;
#     proxy_pass 127.0.0.1:6432;
#     proxy_timeout 1h;
#     proxy_connect_timeout 10s;
#     limit_conn pg_pooled_per_ip 100;
# }
#
# Validate and apply:
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo ufw allow from <MISSION_HELM_IP>/32 to any port 27431 proto tcp  # direct A — tighter
#   sudo ufw allow from <APP_SERVER_IP>/32 to any port 27432 proto tcp    # pooled B — app/workers
# Cloud firewall (NSG / security group): same rules there — each <NON_STD_*> allow ONLY
# its IP (never 0.0.0.0/0), grey-cloud DNS. See DEPLOY.md §6 + "Custom Public DB Ports".
#
# Caveats:
# - Some office networks block outbound ports except 80/443 - apps behind
#   those cannot reach a custom port (that's the one case for SNI-routed 443).
# - Cloudflare's orange cloud proxies HTTP only: keep DB hostnames on grey-cloud
#   DNS (or Spectrum) or the TCP never arrives.
#
# ── Custom public port for Mongo/MySQL (optional) ────────────────────────────
# Same shape as above but single port per engine: point the stream at
# 127.0.0.1:9812 (Mongo) or 127.0.0.1:9816 (MySQL) and set the matching
# *_ISSUED_HOST to host:<custom-port> so issued strings carry it
# (no new env var needed - any host:port is accepted as-is for Mongo/MySQL).
# Postgres always uses the two-port split above — never host:port in POSTGRES_ISSUED_HOST.
#
# server {
#     listen <custom-port> ssl;
#     proxy_pass 127.0.0.1:9812;  # or 127.0.0.1:9816 for MySQL
#     ssl_certificate     /etc/letsencrypt/live/<host>/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/<host>/privkey.pem;
# }
